# SoulMD Hub - Apache 配置文件

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ==========================================
    # 1. 外部重定向 (External Redirects - 301)
    # ==========================================

    # 將 /soul.php?id=123 自動轉址到 /soul/123
    RewriteCond %{THE_REQUEST} \s/+soul\.php\?id=([0-9]+) [NC]
    RewriteRule ^soul\.php$ /soul/%1? [R=301,L]

    # 將 /soul-versions.php?id=123 自動轉址到 /soul-versions/123
    RewriteCond %{THE_REQUEST} \s/+soul-versions\.php\?id=([0-9]+) [NC]
    RewriteRule ^soul-versions\.php$ /soul-versions/%1? [R=301,L]

    # 將 /api/soul.php?id=123 自動轉址到 /api/soul/123
    RewriteCond %{THE_REQUEST} \s/+api/soul\.php\?id=([0-9]+) [NC]
    RewriteRule ^api/soul\.php$ /api/soul/%1? [R=301,L]

    # 將其他所有直接訪問 .php 的請求，轉址到不帶 .php 的網址
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^(.*)\.php$ /$1 [R=301,L]


    # ==========================================
    # 2. 內部重寫 (Internal Rewrites)
    # ==========================================

    # --- 新增：Download & Raw Files 路由 ---
    # 1. ZIP 下載: /download/soul/[username]/[id]/[title].zip
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^download/soul/([^/]+)/([0-9]+)/([^/]+)\.zip$ download.php?username=$1&id=$2&title=$3&format=zip [L,QSA]

    # 2. 單一檔案下載: /download/soul/[username]/[id]/[title]/[filepath...]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^download/soul/([^/]+)/([0-9]+)/([^/]+)/(.*)$ download.php?username=$1&id=$2&title=$3&file=$4 [L,QSA]
    # ---------------------------------------

    # 處理 Soul 詳情頁 (/soul/123)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^soul/([0-9]+)/?$ soul.php?id=$1 [L,QSA]

    # 處理 Soul 版本歷史頁 (/soul-versions/123)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^soul-versions/([0-9]+)/?$ soul-versions.php?id=$1 [L,QSA]

    # 處理 API 單一 Soul (/api/soul/123)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/soul/([0-9]+)/?$ api/soul.php?id=$1 [L,QSA]

    # 處理 API 列表 (/api/souls)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/souls/?$ api/souls.php [L,QSA]

    # 通用規則：自動隱藏所有 .php 副檔名
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L,QSA]


    # ==========================================
    # 3. 安全性設定
    # ==========================================
    RewriteRule ^(config\.php|\.env) - [F,L]
</IfModule>

# 安全請求頭 (Security Headers)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    # 允許跨域請求讀取 Raw Files (方便其他開發者調用)
    Header set Access-Control-Allow-Origin "*" env=HTTP_ORIGIN
</IfModule>

# 防止目錄列表泄露
Options -Indexes

# 緩存靜態資源
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>