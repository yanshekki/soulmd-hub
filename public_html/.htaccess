# SoulMD Hub - Apache 配置文件 (終極 SEO API-First 整合版)

ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ==========================================
    # 1. 外部重定向 (External Redirects - 301)
    # ==========================================
    RewriteCond %{THE_REQUEST} \s/+soul\.php\?id=([0-9]+) [NC]
    RewriteRule ^soul\.php$ /soul/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+soul-versions\.php\?id=([0-9]+) [NC]
    RewriteRule ^soul-versions\.php$ /soul-versions/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+api/soul\.php\?id=([0-9]+) [NC]
    RewriteRule ^api/soul\.php$ /api/soul/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+api-docs\.php[\s?] [NC]
    RewriteRule ^api-docs\.php$ /api-docs [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^(.*)\.php$ /$1 [R=301,L]

    # ==========================================
    # 2. 內部重寫 (Internal Rewrites)
    # ==========================================
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
    RewriteRule ^robots\.txt$ robots.php [L,QSA]
    RewriteRule ^api-docs/?$ api-docs.php [L,QSA]
    
    # 🚨 新增核心商業與個人紀錄路由
    RewriteRule ^upgrade/?$ upgrade.php [L,QSA]
    RewriteRule ^my-chats/?$ my-chats.php [L,QSA]
    RewriteRule ^api/paypal/?$ api/paypal.php [L,QSA]

    # 用戶主頁
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^profile/([^/]+)/?$ profile.php?username=$1 [L,QSA]
    
    # 聊天室路由
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^chat/([0-9]+)/([a-zA-Z0-9_-]+)/?$ chat.php?soul_id=$1&session_token=$2 [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^chat/([0-9]+)/?$ chat.php?soul_id=$1 [L,QSA]

    # 下載模組
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^download/soul/([^/]+)/([0-9]+)/([^/]+)/([^/]+)\.zip$ download.php?username=$1&id=$2&format=zip [B,L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^download/soul/([^/]+)/([0-9]+)/([^/]+)\.zip$ download.php?username=$1&id=$2&format=zip [B,L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^download/soul/([^/]+)/([0-9]+)/([^/]+)/([^/]+)/(.*)$ download.php?username=$1&id=$2&file=$5 [B,L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^download/soul/([^/]+)/([0-9]+)/([^/]+)/(.*)$ download.php?username=$1&id=$2&file=$4 [B,L,QSA]

    # Soul 詳情頁
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^soul/([^/]+)/([0-9]+)/([^/]+)/([^/]+)/?$ soul.php?id=$2 [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^soul/([0-9]+)/?$ soul.php?id=$1 [L,QSA]

    # 版本歷史
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^soul-versions/([0-9]+)/?$ soul-versions.php?id=$1 [L,QSA]

    # API 模組
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/soul/([0-9]+)/?$ api/soul.php?id=$1 [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/souls/?$ api/souls.php [L,QSA]

    # 通用自動隱藏 .php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L,QSA]

    # ==========================================
    # 3. 安全性設定
    # ==========================================
    RewriteRule ^(config\.php|\.env) - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header set Access-Control-Allow-Origin "*" env=HTTP_ORIGIN
</IfModule>

Options -Indexes

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>